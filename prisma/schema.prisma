// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────────────────────

enum GoalStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  OVERDUE
}

enum GoalPriority {
  LOW
  MEDIUM
  HIGH
}

enum GoalCategory {
  PERSONAL
  CAREER
  FITNESS
  EDUCATION
  FINANCE
  HEALTH
  RELATIONSHIPS
  OTHER
}

enum NotificationType {
  HABIT_REMINDER
  GOAL_REMINDER
  WEEKLY_REPORT
  ACHIEVEMENT
  MOTIVATION
}

enum DebtStatus {
  ACTIVE
  PAID
}

// ─────────────────────────────────────────────────────────────────────────────
// Users
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  name            String
  passwordHash    String?
  googleId        String?   @unique
  appleId         String?   @unique
  avatarUrl       String?
  fcmToken        String?
  // IANA timezone name (e.g. "Asia/Kolkata") used to schedule habit/goal
  // reminders at the user's local clock. Null = fall back to the server's
  // REMINDER_TIMEZONE (or server-local time).
  timezone        String?
  currentStreak   Int       @default(0)
  longestStreak   Int       @default(0)
  isEmailVerified Boolean   @default(false)
  savingsBalance  Float     @default(0.0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  habits             Habit[]
  goals              Goal[]
  habitLogs          HabitLog[]
  aiReports          AiReport[]
  notifications      Notification[]
  refreshTokens      RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  missedHabitReasons MissedHabitReason[]
  monthlyBudgets     MonthlyBudget[]
  expenses           Expense[]
  monthlySettlements MonthlySettlement[]
  extraIncomes       ExtraIncome[]
  debts              Debt[]

  @@index([email])
  @@index([googleId])
  @@map("users")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([token])
  @@map("refresh_tokens")
}

// ─────────────────────────────────────────────────────────────────────────────
// Habits
// ─────────────────────────────────────────────────────────────────────────────

model Habit {
  id           String        @id @default(cuid())
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  category     String @default("OTHER")
  emoji        String?
  color        String?
  repeatDays   Boolean[]     @default([true, true, true, true, true, true, true])
  reminderTime String?       // "HH:MM" format
  notes        String?
  isActive     Boolean       @default(true)
  currentStreak Int          @default(0)
  longestStreak Int          @default(0)
  totalCompleted Int         @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  logs               HabitLog[]
  missedHabitReasons MissedHabitReason[]

  @@index([userId])
  @@index([userId, isActive])
  @@map("habits")
}

// ─────────────────────────────────────────────────────────────────────────────
// Habit Logs
// ─────────────────────────────────────────────────────────────────────────────

model HabitLog {
  id          String    @id @default(cuid())
  habitId     String
  habit       Habit     @relation(fields: [habitId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  date        DateTime  @db.Date
  completedAt DateTime?
  isSkipped   Boolean   @default(false)
  skipReason  String?
  notes       String?
  createdAt   DateTime  @default(now())

  @@unique([habitId, date])
  @@index([habitId])
  @@index([userId, date])
  @@index([date])
  @@map("habit_logs")
}

// ─────────────────────────────────────────────────────────────────────────────
// Goals
// ─────────────────────────────────────────────────────────────────────────────

model Goal {
  id          String       @id @default(cuid())
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  category     GoalCategory @default(PERSONAL)
  description  String?
  targetDate   DateTime
  priority     GoalPriority @default(MEDIUM)
  status       GoalStatus   @default(IN_PROGRESS)
  progress     Float        @default(0)
  // Target amount expressed in the goal's unit (e.g. 5 for a 5 kg weight goal).
  // 0 means "not set" — legacy goals fall back to parsing the target from the
  // goal name. Stored as Float so measurement goals (kg, km, L, hours) can hold
  // fractional targets like 0.5; integer-only enforcement happens in DTO/service
  // validation based on the unit, not in the column type.
  target       Float        @default(0)
  // Measurement/count unit for the target & progress values (kg, km, L, hours,
  // ₹, books, tasks, workouts, ...). Empty string = no unit (legacy goals).
  unit         String       @default("")
  durationDays Int          @default(30)
  notes        String?
  createdAt    DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  progressHistory GoalProgress[]

  @@index([userId])
  @@index([userId, status])
  @@index([targetDate])
  @@map("goals")
}

model GoalProgress {
  id        String   @id @default(cuid())
  goalId    String
  goal      Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)
  progress  Float
  notes     String?
  recordedAt DateTime @default(now())

  @@index([goalId])
  @@map("goal_progress")
}

// ─────────────────────────────────────────────────────────────────────────────
// AI Reports
// ─────────────────────────────────────────────────────────────────────────────

model AiReport {
  id                  String   @id @default(cuid())
  userId              String
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  weekStart           DateTime
  weekEnd             DateTime
  productivityScore   Int      @default(0)
  weeklyReport        String
  strengths           String[]
  weaknesses          String[]
  recommendations     String[]
  rawResponse         Json?
  createdAt           DateTime @default(now())

  @@index([userId])
  @@index([userId, weekStart])
  @@map("ai_reports")
}

// ─────────────────────────────────────────────────────────────────────────────
// Notifications
// ─────────────────────────────────────────────────────────────────────────────

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String
  data      Json?
  isRead    Boolean          @default(false)
  sentAt    DateTime         @default(now())
  readAt    DateTime?

  @@index([userId])
  @@index([userId, isRead])
  @@map("notifications")
}

// ─────────────────────────────────────────────────────────────────────────────
// Missed Habit Reasons (Accountability / AI Analytics)
// ─────────────────────────────────────────────────────────────────────────────

model MissedHabitReason {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  habitId    String
  habit      Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)
  missedDate DateTime @db.Date
  reason     String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, habitId, missedDate])
  @@index([userId])
  @@index([userId, missedDate])
  @@index([habitId])
  @@map("missed_habit_reasons")
}

// ─────────────────────────────────────────────────────────────────────────────
// Expense Tracker
// ─────────────────────────────────────────────────────────────────────────────

enum ExpenseCategory {
  FOOD
  TRANSPORT
  SHOPPING
  BILLS
  HEALTH
  EDUCATION
  ENTERTAINMENT
  TRAVEL
  SALARY
  OTHER
}

enum PaymentMethod {
  CASH
  UPI
  CREDIT_CARD
  DEBIT_CARD
  BANK_TRANSFER
}

model MonthlyBudget {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  month           Int
  year            Int
  monthlyIncome   Float
  savingsTarget   Float
  spendableBudget Float
  dailyGoal       Float
  daysInMonth     Int
  monthlyProfit   Float    @default(0.0)
  monthlyLoss     Float    @default(0.0)
  settled         Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([userId, month, year])
  @@index([userId])
  @@map("monthly_budgets")
}

model Expense {
  id            String          @id @default(cuid())
  userId        String
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  title         String
  amount        Float
  category      ExpenseCategory @default(OTHER)
  paymentMethod PaymentMethod   @default(CASH)
  date          DateTime        @db.Date
  time          String?
  notes         String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([userId])
  @@index([userId, date])
  @@index([userId, category])
  @@map("expenses")
}

model MonthlySettlement {
  id                      String   @id @default(cuid())
  userId                  String
  user                    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  month                   Int
  year                    Int
  totalBudget             Float
  totalExpenses           Float
  totalProfit             Float
  totalLoss               Float
  netResult               Float
  savingsBeforeSettlement Float
  savingsAfterSettlement  Float
  settlementDate          DateTime @default(now())

  @@unique([userId, month, year])
  @@index([userId])
  @@map("monthly_settlements")
}

// ─────────────────────────────────────────────────────────────────────────────
// Extra Income (standalone financial log — independent of the expense budget,
// income, savings, P&L, analytics and reports. Purely informational.)
// ─────────────────────────────────────────────────────────────────────────────

model ExtraIncome {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  amount    Float
  date      DateTime @db.Date
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([userId, date])
  @@map("extra_incomes")
}

// ─────────────────────────────────────────────────────────────────────────────
// Debt / Loan Tracker (standalone — never feeds Cash Flow calculations)
// ─────────────────────────────────────────────────────────────────────────────

model Debt {
  id               String     @id @default(cuid())
  userId           String
  user             User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  name             String
  originalAmount   Float
  lenderName       String?
  dueDate          DateTime?
  installmentAmount Float?
  description      String?
  status           DebtStatus @default(ACTIVE)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  payments DebtPayment[]

  @@index([userId])
  @@index([userId, status])
  @@map("debts")
}

model DebtPayment {
  id          String   @id @default(cuid())
  debtId      String
  debt        Debt     @relation(fields: [debtId], references: [id], onDelete: Cascade)
  amount      Float
  paymentDate DateTime
  note        String?
  createdAt   DateTime @default(now())

  @@index([debtId])
  @@index([debtId, paymentDate])
  @@map("debt_payments")
}
