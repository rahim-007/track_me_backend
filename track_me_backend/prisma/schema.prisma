// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────────────────────

enum GoalStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  OVERDUE
}

enum GoalPriority {
  LOW
  MEDIUM
  HIGH
}

enum GoalCategory {
  PERSONAL
  CAREER
  FITNESS
  EDUCATION
  FINANCE
  HEALTH
  RELATIONSHIPS
  OTHER
}

enum NotificationType {
  HABIT_REMINDER
  GOAL_REMINDER
  WEEKLY_REPORT
  ACHIEVEMENT
  MOTIVATION
}

enum DebtStatus {
  ACTIVE
  PAID
}

// ─────────────────────────────────────────────────────────────────────────────
// Users
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  name            String
  passwordHash    String?
  googleId        String?   @unique
  appleId         String?   @unique
  avatarUrl       String?
  fcmToken        String?
  // IANA timezone name (e.g. "Asia/Kolkata") used to schedule habit/goal
  // reminders at the user's local clock. Null = fall back to the server's
  // REMINDER_TIMEZONE (or server-local time).
  timezone        String?
  currentStreak   Int       @default(0)
  longestStreak   Int       @default(0)
  isEmailVerified Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  habits             Habit[]
  goals              Goal[]
  habitLogs          HabitLog[]
  aiReports          AiReport[]
  notifications      Notification[]
  refreshTokens      RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  missedHabitReasons MissedHabitReason[]
  cashFlowPeriods    CashFlowPeriod[]
  cashFlowDebts      CashFlowDebt[]

  @@index([email])
  @@index([googleId])
  @@map("users")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([token])
  @@map("refresh_tokens")
}

// ─────────────────────────────────────────────────────────────────────────────
// Habits
// ─────────────────────────────────────────────────────────────────────────────

model Habit {
  id           String        @id @default(cuid())
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  category     String @default("OTHER")
  emoji        String?
  color        String?
  repeatDays   Boolean[]     @default([true, true, true, true, true, true, true])
  reminderTime String?       // "HH:MM" format
  notes        String?
  isActive     Boolean       @default(true)
  currentStreak Int          @default(0)
  longestStreak Int          @default(0)
  totalCompleted Int         @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  logs               HabitLog[]
  missedHabitReasons MissedHabitReason[]

  @@index([userId])
  @@index([userId, isActive])
  @@map("habits")
}

// ─────────────────────────────────────────────────────────────────────────────
// Habit Logs
// ─────────────────────────────────────────────────────────────────────────────

model HabitLog {
  id          String    @id @default(cuid())
  habitId     String
  habit       Habit     @relation(fields: [habitId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  date        DateTime  @db.Date
  completedAt DateTime?
  isSkipped   Boolean   @default(false)
  skipReason  String?
  notes       String?
  createdAt   DateTime  @default(now())

  @@unique([habitId, date])
  @@index([habitId])
  @@index([userId, date])
  @@index([date])
  @@map("habit_logs")
}

// ─────────────────────────────────────────────────────────────────────────────
// Goals
// ─────────────────────────────────────────────────────────────────────────────

model Goal {
  id          String       @id @default(cuid())
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  category     GoalCategory @default(PERSONAL)
  description  String?
  targetDate   DateTime
  priority     GoalPriority @default(MEDIUM)
  status       GoalStatus   @default(IN_PROGRESS)
  progress     Float        @default(0)
  // Target amount expressed in the goal's unit (e.g. 5 for a 5 kg weight goal).
  // 0 means "not set" — legacy goals fall back to parsing the target from the
  // goal name. Stored as Float so measurement goals (kg, km, L, hours) can hold
  // fractional targets like 0.5; integer-only enforcement happens in DTO/service
  // validation based on the unit, not in the column type.
  target       Float        @default(0)
  // Measurement/count unit for the target & progress values (kg, km, L, hours,
  // ₹, books, tasks, workouts, ...). Empty string = no unit (legacy goals).
  unit         String       @default("")
  durationDays Int          @default(30)
  notes        String?
  createdAt    DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  progressHistory GoalProgress[]

  @@index([userId])
  @@index([userId, status])
  @@index([targetDate])
  @@map("goals")
}

model GoalProgress {
  id        String   @id @default(cuid())
  goalId    String
  goal      Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)
  progress  Float
  notes     String?
  recordedAt DateTime @default(now())

  @@index([goalId])
  @@map("goal_progress")
}

// ─────────────────────────────────────────────────────────────────────────────
// AI Reports
// ─────────────────────────────────────────────────────────────────────────────

model AiReport {
  id                  String   @id @default(cuid())
  userId              String
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  weekStart           DateTime
  weekEnd             DateTime
  productivityScore   Int      @default(0)
  weeklyReport        String
  strengths           String[]
  weaknesses          String[]
  recommendations     String[]
  rawResponse         Json?
  createdAt           DateTime @default(now())

  @@index([userId])
  @@index([userId, weekStart])
  @@map("ai_reports")
}

// ─────────────────────────────────────────────────────────────────────────────
// Notifications
// ─────────────────────────────────────────────────────────────────────────────

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String
  data      Json?
  isRead    Boolean          @default(false)
  sentAt    DateTime         @default(now())
  readAt    DateTime?

  @@index([userId])
  @@index([userId, isRead])
  @@map("notifications")
}

// ─────────────────────────────────────────────────────────────────────────────
// Missed Habit Reasons (Accountability / AI Analytics)
// ─────────────────────────────────────────────────────────────────────────────

model MissedHabitReason {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  habitId    String
  habit      Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)
  missedDate DateTime @db.Date
  reason     String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, habitId, missedDate])
  @@index([userId])
  @@index([userId, missedDate])
  @@index([habitId])
  @@map("missed_habit_reasons")
}

// ─────────────────────────────────────────────────────────────────────────────
// Cash Flow Tracker
//
// One CashFlowPeriod per calendar month per user. Opening balances carry
// forward from the previous period's computed closing balances; closing
// balances themselves are never stored. Transactions belong to exactly one
// period and are reset each month. The debt ledger (CashFlowDebt) is a
// continuous give/receive list that is NOT reset at month boundaries.
// ─────────────────────────────────────────────────────────────────────────────

enum CashFlowTxnKind {
  INCOME
  OUTFLOW
}

model CashFlowPeriod {
  id                String @id @default(cuid())
  userId            String
  user              User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  month             Int // 1-12
  year              Int
  openingBank       Float
  openingCash       Float
  openingCreditCard Float
  openingDebt       Float
  createdAt         DateTime @default(now())

  transactions CashFlowTransaction[]

  @@unique([userId, month, year])
  @@index([userId])
  @@map("cashflow_periods")
}

model CashFlowTransaction {
  id        String          @id @default(cuid())
  periodId  String
  period    CashFlowPeriod  @relation(fields: [periodId], references: [id], onDelete: Cascade)
  kind      CashFlowTxnKind
  category  String // income: E | S | B | I | G ; outflow: E | S | D | I
  amount    Float
  note      String?
  date      DateTime        @db.Date
  createdAt DateTime        @default(now())

  @@index([periodId])
  @@index([periodId, date])
  @@map("cashflow_transactions")
}

enum CashFlowDebtDirection {
  GIVE // I owe them
  RECEIVE // they owe me
}

model CashFlowDebt {
  id        String                @id @default(cuid())
  userId    String
  user      User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  direction CashFlowDebtDirection
  person    String
  amount    Float
  note      String?
  date      DateTime              @db.Date
  settled   Boolean               @default(false)
  settledAt DateTime?
  createdAt DateTime              @default(now())

  @@index([userId])
  @@index([userId, direction, settled])
  @@map("cashflow_debts")
}

// ─────────────────────────────────────────────────────────────────────────────
//
