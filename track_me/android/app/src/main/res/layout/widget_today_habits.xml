<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_habits_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card_bg"
    android:orientation="vertical"
    android:clipChildren="true"
    android:clipToPadding="true"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="10dp"
    android:paddingBottom="8dp">

    <!-- Header: UrDay Title + Progress Pill + Quick Add Button -->
    <LinearLayout
        android:id="@+id/layout_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_marginBottom="6dp">

        <LinearLayout
            android:id="@+id/btn_header_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/iv_habits_sparkle"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_widget_sparkle"
                android:contentDescription="UrDay" />

            <TextView
                android:id="@+id/tv_habits_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:singleLine="true"
                android:maxLines="1"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:text="UrDay · Today's Habits"
                android:textColor="@color/widget_text_primary"
                android:textSize="12.5sp"
                android:textStyle="bold" />

            <!-- Preserved for backwards-compatibility -->
            <TextView
                android:id="@+id/tv_last_updated"
                android:layout_width="1dp"
                android:layout_height="1dp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Progress Score Pill -->
        <LinearLayout
            android:id="@+id/layout_progress_pill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:background="@drawable/widget_compact_pill_bg"
            android:gravity="center"
            android:paddingStart="8dp"
            android:paddingTop="3.5dp"
            android:paddingEnd="8dp"
            android:paddingBottom="3.5dp">

            <TextView
                android:id="@+id/tv_habits_progress_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:text="0/0 (0%)"
                android:textColor="@color/widget_compact_pill_text"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Quick Add Habit Circular Button -->
        <ImageView
            android:id="@+id/btn_quick_add"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/widget_compact_add_btn"
            android:contentDescription="Quick add habit"
            android:padding="6.5dp"
            android:src="@drawable/ic_widget_add" />
    </LinearLayout>

    <!-- Scrollable Habits ListView (Swipes up & down for all habits) -->
    <ListView
        android:id="@+id/lv_habits"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipChildren="true"
        android:clipToPadding="true"
        android:divider="@color/widget_border"
        android:dividerHeight="0.6dp"
        android:footerDividersEnabled="false"
        android:headerDividersEnabled="false"
        android:overScrollMode="never"
        android:scrollbars="none" />

    <!-- Empty State View -->
    <TextView
        android:id="@+id/tv_empty_habits"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="Open UrDay to schedule today\'s habits ✨"
        android:textColor="@color/widget_text_muted"
        android:textSize="11.5sp"
        android:visibility="gone" />

</LinearLayout>
