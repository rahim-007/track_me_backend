                android:layout_height="38dp"
                android:background="@drawable/widget_compact_icon_circle">

                <TextView
                    android:id="@+id/tv_compact_emoji_1"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:singleLine="true"
                    android:maxLines="1"
                    android:ellipsize="none"
                    android:textColor="@color/widget_text_primary"
                    android:text="⚡"
                    android:textSize="17.5sp" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/btn_compact_check_1"
                android:layout_width="26dp"
                android:layout_height="20dp"
                android:layout_marginTop="2.5dp">

                <ImageView
                    android:id="@+id/iv_compact_check_1"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_gravity="center"
                    android:contentDescription="Check 1"
                    android:src="@drawable/ic_widget_uncheck" />
            </FrameLayout>
        </LinearLayout>

        <!-- Compact Col 2 -->
        <LinearLayout
            android:id="@+id/col_compact_2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
