<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_habits_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card_bg"
    android:orientation="vertical"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="9dp"
    android:paddingBottom="9dp">

    <!-- Header: UrDay Title + Progress Pill + Quick Add Button -->
    <LinearLayout
        android:id="@+id/layout_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_marginBottom="4dp">

        <LinearLayout
            android:id="@+id/btn_header_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/iv_habits_sparkle"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_widget_sparkle"
                android:contentDescription="UrDay" />

            <TextView
                android:id="@+id/tv_habits_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:singleLine="true"
                android:maxLines="1"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:text="UrDay · Today's Habits"
                android:textColor="@color/widget_text_primary"
                android:textSize="12.5sp"
                android:textStyle="bold" />

            <!-- Legacy view preserved as gone -->
            <TextView
                android:id="@+id/tv_last_updated"
                android:layout_width="1dp"
                android:layout_height="1dp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Progress Score Pill -->
        <LinearLayout
            android:id="@+id/layout_progress_pill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:background="@drawable/widget_compact_pill_bg"
            android:gravity="center"
            android:paddingStart="8dp"
            android:paddingTop="3.5dp"
            android:paddingEnd="8dp"
            android:paddingBottom="3.5dp">

            <TextView
                android:id="@+id/tv_habits_progress_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:text="0/0 (0%)"
                android:textColor="@color/widget_compact_pill_text"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Quick Add Habit Circular Button -->
        <ImageView
            android:id="@+id/btn_quick_add"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/widget_compact_add_btn"
            android:contentDescription="Quick add habit"
            android:padding="6.5dp"
            android:src="@drawable/ic_widget_add" />
    </LinearLayout>

    <!-- 1. Vertical Habit Rows View (Large & Medium Modes) -->
    <LinearLayout
        android:id="@+id/layout_habits_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Slot 1 -->
        <LinearLayout
            android:id="@+id/row_habit_1"
            android:layout_width="match_parent"
            android:layout_height="26dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <FrameLayout
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:background="@drawable/widget_icon_circle_bg">

                <TextView
                    android:id="@+id/tv_emoji_1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:includeFontPadding="false"
                    android:text="⚡"
                    android:textSize="11sp" />
            </FrameLayout>

            <TextView
                android:id="@+id/tv_title_1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:singleLine="true"
                android:text="Habit 1"
                android:textColor="@color/widget_text_primary"
                android:textSize="11.5sp" />

            <TextView
                android:id="@+id/tv_streak_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:includeFontPadding="false"
                android:text="🔥 0"
                android:textColor="@color/widget_flame"
                android:textSize="10.5sp"
                android:textStyle="bold" />

            <FrameLayout
                android:id="@+id/btn_check_1"
                android:layout_width="32dp"
                android:layout_height="26dp"
                android:layout_gravity="center_vertical">

                <ImageView
                    android:id="@+id/iv_check_1"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_gravity="center"
                    android:contentDescription="Toggle habit 1"
                    android:src="@drawable/ic_widget_uncheck" />
            </FrameLayout>
        </LinearLayout>

        <ImageView
            android:id="@+id/divider_1"
            android:layout_width="match_parent"
            android:layout_height="0.6dp"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="2dp"
            android:background="@color/widget_border"
