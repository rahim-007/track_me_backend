<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_progress_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:gravity="center"
    android:padding="4dp">

    <!-- Wrapper centering both circular widgets -->
    <RelativeLayout
        android:id="@+id/circles_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:clipChildren="false"
        android:clipToPadding="false">

        <!-- Secondary Circle (Date & Calendar)
             Declared first so it renders behind the main progress circle's edge -->
        <FrameLayout
            android:id="@+id/secondary_circle_container"
            android:layout_width="84dp"
            android:layout_height="84dp"
            android:layout_toEndOf="@+id/main_circle_container"
            android:layout_marginStart="-10dp"
            android:layout_centerVertical="true"
            android:background="@drawable/widget_circle_secondary_bg">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="8dp">

                <ImageView
                    android:id="@+id/iv_calendar_icon"
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:src="@drawable/ic_widget_calendar"
                    android:contentDescription="Calendar" />

                <TextView
                    android:id="@+id/tv_date_day"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:singleLine="true"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:text="Tue"
                    android:textColor="@color/widget_text_secondary"
                    android:textSize="10.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_date_day_num"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:singleLine="true"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:text="Sep 16"
                    android:textColor="@color/widget_text_primary"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </FrameLayout>

        <!-- Main Circle (UrDay Brand + Progress Ring + Percentage + Streak)
             Declared second so it overlaps on top with subtle elevation -->
        <FrameLayout
            android:id="@+id/main_circle_container"
            android:layout_width="130dp"
            android:layout_height="130dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:elevation="6dp"
            android:background="@drawable/widget_circle_main_bg">

            <!-- Dynamic circular progress ring bitmap -->
            <ImageView
                android:id="@+id/iv_progress_ring"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitCenter"
                android:contentDescription="Daily Progress Ring" />

            <!-- Inner content overlay with safe internal area (12-14% margin) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp">

                <!-- Top Brand: Sparkle icon + "UrDay" -->
                <LinearLayout
                    android:id="@+id/header_layout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/iv_brand_icon"
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:src="@drawable/ic_widget_sparkle"
                        android:contentDescription="UrDay brand" />

                    <TextView
                        android:id="@+id/tv_app_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="3dp"
                        android:singleLine="true"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:includeFontPadding="false"
                        android:text="UrDay"
                        android:textColor="@color/widget_text_primary"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Center: Completion Percentage + "Today" -->
                <TextView
                    android:id="@+id/tv_progress_percent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:singleLine="true"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:text="0%"
                    android:textColor="@color/widget_text_primary"
                    android:textSize="23sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_progress_subtext"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:text="Today"
                    android:textColor="@color/widget_text_secondary"
                    android:textSize="10sp" />

                <!-- Bottom: Dynamic Streak ("🔥 +2 Streak") -->
                <TextView
                    android:id="@+id/tv_streak_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:gravity="center"
                    android:singleLine="true"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:text="🔥 0 Streak"
                    android:textColor="@color/widget_text_primary"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </FrameLayout>

    </RelativeLayout>

    <!-- Legacy Views Preserved as Gone for 100% Backward Compatibility -->
    <ProgressBar
        android:id="@+id/pb_daily_progress"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tv_progress_ratio"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tv_daily_quote"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone" />

</RelativeLayout>
