<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/row_habit"
    android:layout_width="match_parent"
    android:layout_height="32dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="2dp"
    android:paddingEnd="0dp">

    <FrameLayout
        android:id="@+id/frame_emoji"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:background="@drawable/widget_icon_circle_bg">

        <TextView
            android:id="@+id/tv_emoji"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:includeFontPadding="false"
            android:text="⚡"
            android:textSize="11sp" />
    </FrameLayout>

    <TextView
        android:id="@+id/tv_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:singleLine="true"
        android:text="Habit Title"
        android:textColor="@color/widget_text_primary"
        android:textSize="11.5sp" />

    <TextView
        android:id="@+id/tv_streak"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="6dp"
        android:includeFontPadding="false"
        android:text="🔥 0"
        android:textColor="@color/widget_flame"
        android:textSize="10.5sp"
        android:textStyle="bold" />

    <FrameLayout
        android:id="@+id/btn_check"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_gravity="center_vertical">

        <ImageView
            android:id="@+id/iv_check"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_gravity="center"
            android:contentDescription="Toggle habit"
            android:src="@drawable/ic_widget_uncheck" />
    </FrameLayout>

</LinearLayout>
